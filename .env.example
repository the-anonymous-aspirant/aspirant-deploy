# Docker Compose project name — keeps volume/network names compatible
# with the original aspirant-online deployment so existing data carries over
COMPOSE_PROJECT_NAME=aspirant-online

# Authentication
# Generate a high-entropy secret before the first `docker compose up`:
#   openssl rand -base64 32
# docker-compose.yml gates on this value and refuses to boot if unset.
# The aspirant-server binary additionally rejects known-placeholder values
# ('change-me', 'aspirant_secret', 'aspirant_secret_CHANGE_ME') and values
# shorter than 32 bytes (system_3 #1374).
JWT_SECRET=

# Database (PostgreSQL)
DB_HOST=postgres
DB_USER=aspirant_user
# Generate a high-entropy secret before the first `docker compose up`:
#   openssl rand -base64 32
# docker-compose.yml gates on this value and refuses to boot if unset.
DB_PASSWORD=
DB_NAME=aspirant_online_db

# Least-privilege read-only role for the system_3 cell-signal reader
# (system_3 #5539; security ruling on #5542). When set, the commander
# provisions role `aspirant_signal_ro` at startup — SELECT on
# processed_valuations and nothing else, never aspirant_admin — and the
# system_3 cell-signal cron connects with THIS password (its ASPIRANT_DB_DSN
# must carry the same value). Leave blank to disable the reader entirely: the
# commander then creates no role rather than one with a default credential.
#   openssl rand -base64 32
ASPIRANT_SIGNAL_RO_PASSWORD=

# Penpot design service (system_3 #2195)
# Both values are MIGRATED from the dev-box ~/penpot/.env — do not
# regenerate: a new PENPOT_SECRET_KEY invalidates all sessions and
# signed asset URLs; a new PENPOT_DB_PASSWORD breaks the restored DB.
# docker-compose.yml gates on both values and refuses to boot if unset.
PENPOT_SECRET_KEY=
PENPOT_DB_PASSWORD=
