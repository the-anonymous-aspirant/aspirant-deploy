# Docker Compose project name — keeps volume/network names compatible
# with the original aspirant-online deployment so existing data carries over
COMPOSE_PROJECT_NAME=aspirant-online

# Authentication
JWT_SECRET=change-me

# Database (PostgreSQL)
DB_HOST=postgres
DB_USER=aspirant_user
# Generate a high-entropy secret before the first `docker compose up`:
#   openssl rand -base64 32
# docker-compose.yml gates on this value and refuses to boot if unset.
DB_PASSWORD=
DB_NAME=aspirant_online_db
FINANCE_URL=http://finance:8000
