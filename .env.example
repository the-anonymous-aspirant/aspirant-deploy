# Docker Compose project name — keeps volume/network names compatible
# with the original aspirant-online deployment so existing data carries over
COMPOSE_PROJECT_NAME=aspirant-online

# Authentication
# Generate a high-entropy secret before the first `docker compose up`:
#   openssl rand -base64 32
# docker-compose.yml gates on this value and refuses to boot if unset.
# The aspirant-server binary additionally rejects known-placeholder values
# ('change-me', 'aspirant_secret', 'aspirant_secret_CHANGE_ME') and values
# shorter than 32 bytes (system_3 #1374).
JWT_SECRET=

# Database (PostgreSQL)
DB_HOST=postgres
DB_USER=aspirant_user
# Generate a high-entropy secret before the first `docker compose up`:
#   openssl rand -base64 32
# docker-compose.yml gates on this value and refuses to boot if unset.
DB_PASSWORD=
DB_NAME=aspirant_online_db

# Least-privilege read-only role for the system_3 cell-signal reader
# (system_3 #5539; security ruling on #5542). When set, the commander
# provisions role `aspirant_signal_ro` at startup — SELECT on
# processed_valuations and nothing else, never aspirant_admin — and the
# system_3 cell-signal cron connects with THIS password (its ASPIRANT_DB_DSN
# must carry the same value). Leave blank to disable the reader entirely: the
# commander then creates no role rather than one with a default credential.
# Leave it UNSET once commander runs as aspirant_commander (system_3 #9317):
# that role cannot create roles, so commander would fail this step. The role
# is provisioned by system_3's scripts/provision_aspirant_signal_ro.py (#6226),
# and scripts/db-roles.sh points its search_path at commander's schema.
#   openssl rand -base64 32
ASPIRANT_SIGNAL_RO_PASSWORD=

# Per-service database roles (system_3 #9317). transcriber, commander, advisor
# and browser each log in as their own non-superuser role, with its tables in a
# schema of its own, instead of sharing DB_USER (a superuser) with server.
# scripts/db-roles.sh creates the roles and sets these passwords; it refuses
# to run while any of the six is empty. See docs/OPERATIONS.md, "Per-service
# database roles".
#   openssl rand -hex 32
# Keep them hex: db-roles.sh strips quotes itself rather than using compose's
# .env parser, and the two agree only on plain values. A password with `$`, `#`
# or quotes can give a role that compose then cannot log in as.
ASPIRANT_TRANSCRIBER_DB_PASSWORD=
ASPIRANT_COMMANDER_DB_PASSWORD=
ASPIRANT_ADVISOR_DB_PASSWORD=
ASPIRANT_BROWSER_DB_PASSWORD=
# aspirant-server's runtime role (DML only) and migration role (owns its tables,
# runs AutoMigrate), system_3 #9324.
ASPIRANT_SERVER_DB_PASSWORD=
ASPIRANT_SERVER_OWNER_DB_PASSWORD=
# Each service keeps the admin pair (DB_USER/DB_PASSWORD) until it is cut over
# (system_3 #9320). The cutover, after `db-roles.sh move <svc>`, adds these two
# lines for that service; the second refers to the password above rather than
# copying it. Deleting them is the rollback. Leave them out until then.
#   ASPIRANT_COMMANDER_DB_USER=aspirant_commander
#   ASPIRANT_COMMANDER_DB_LOGIN_PASSWORD=${ASPIRANT_COMMANDER_DB_PASSWORD}
# aspirant-server has two switches (system_3 #9324-B1): server-migrate logs in
# as the migration role, server as the runtime role. Both go in at the go-live
# (#9324-C1), after `db-roles.sh move server`:
#   ASPIRANT_SERVER_OWNER_DB_USER=aspirant_server_owner
#   ASPIRANT_SERVER_OWNER_DB_LOGIN_PASSWORD=${ASPIRANT_SERVER_OWNER_DB_PASSWORD}
#   ASPIRANT_SERVER_DB_USER=aspirant_server
#   ASPIRANT_SERVER_DB_LOGIN_PASSWORD=${ASPIRANT_SERVER_DB_PASSWORD}

# Penpot design service (system_3 #2195)
# Both values are MIGRATED from the dev-box ~/penpot/.env — do not
# regenerate: a new PENPOT_SECRET_KEY invalidates all sessions and
# signed asset URLs; a new PENPOT_DB_PASSWORD breaks the restored DB.
# docker-compose.yml gates on both values and refuses to boot if unset.
PENPOT_SECRET_KEY=
PENPOT_DB_PASSWORD=

# Admin second factor: Cloudflare Access One-time PIN (system_3 #8798).
# aspirant-server issues the Admin tier only through POST /login/admin (the
# browser's /admin/sign-in), and while the gate is on that route needs a valid
# Cf-Access-Jwt-Assertion from the /admin Access application, or the
# break-glass token below. The server reads these through `env_file: .env`.
#
# The mode follows from the three CF_ACCESS_* names, and /health publishes it
# as `admin_second_factor`:
#   off            all three empty: the password alone gives Admin (as before)
#   enforced       all three set, the team domain a bare <team>.cloudflareaccess.com
#   misconfigured  anything else: it fails closed, break-glass only
# A change of mode signs every Admin out at the next server start.
#   CF_ACCESS_TEAM_DOMAIN  the team host, no scheme or path: <team>.cloudflareaccess.com
#   CF_ACCESS_AUD          the /admin application's Application Audience (AUD) tag
#   CF_ACCESS_ADMIN_EMAIL  the one address the Access policy admits
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ADMIN_EMAIL=

# The break-glass token, accepted in place of the Access assertion on the admin
# sign-in only when it arrives through the client's loopback 8098 listener
# (docs/OPERATIONS.md, break-glass). The SAME value goes in the client nginx's
# secrets drop-in /data/aspirant/nginx-secrets/break-glass.conf as
#   set $break_glass_token "<value>";
# Empty = break-glass off. Generate with:
#   openssl rand -hex 32
BREAK_GLASS_TOKEN=

# The dedicated smoke-sweep account's user id (system_3 #10490-A1's Source
# classification on proxy_request_log; #10494's security ruling c64784
# deliberately left no hardcoded default, so a call from this user id is the
# ONLY thing that classifies as `source=smoke` rather than `member`).
# scripts/smoke_valuation_e2e.py mints its token for this id (its own
# default, 14, is that script's fallback, not a substitute for setting this).
# Left unset, every smoke-sweep call is misclassified as real member traffic
# -- found and fixed on system_3 #10497, after shipping unset for a week.
SMOKE_USER_ID=
