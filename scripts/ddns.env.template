# Cloudflare DDNS credentials for scripts/update-dns.sh.
#
# Install as ~/.config/aspirant/ddns.env, owned by the user whose crontab runs
# update-dns.sh (currently `aspirant`), mode 0600:
#
#   install -D -m 600 scripts/ddns.env.template ~/.config/aspirant/ddns.env
#   ${EDITOR:-vi} ~/.config/aspirant/ddns.env
#
# NOT root-owned: the cron entry is in the `aspirant` user's crontab, so a
# root-owned 0600 file is unreadable by the job and DDNS fails on the first
# tick after the change.
#
# This template is committed. The rendered file is not, and never lives in a
# repository checkout — see docs/OPERATIONS.md §Cloudflare DDNS credential.

# API token. Scope it to Zone:DNS:Edit on the-aspirant.com only — the record
# IDs below are the only two records this script touches, and a zone-wide
# token lets anything able to read this file repoint the apex A record.
CF_TOKEN=

# Zone ID for the-aspirant.com (Cloudflare dashboard → the zone → Overview).
ZONE_ID=

# A-record IDs. Read them back with:
#   curl -s -H "Authorization: Bearer $CF_TOKEN" \
#     "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records?type=A"
ROOT_RECORD_ID=
HOME_RECORD_ID=
